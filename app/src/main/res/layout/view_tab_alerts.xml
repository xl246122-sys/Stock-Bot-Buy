<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_dark_background"
    android:padding="16dp">

    <!-- 1. Google 规范预警控制面板卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_dark"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_alerts"
                app:tint="@color/stock_up_red"
                android:contentDescription="预警" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="盘中毫秒级声光预警控制台"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● 3分钟同标的智能防轰炸冷却已激活"
                    android:textColor="@color/stock_cyan"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_alert_master"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_subtle"
            android:layout_marginVertical="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="高阶触觉阶梯震动 (Haptic Engine) &amp; 警报铃声"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_haptic_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. 操作快捷栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tv_unread_alerts_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="实时预警流水 (2 条未读)"
            android:textColor="@color/text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_mark_all_read"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="全部已读"
            android:textColor="@color/stock_cyan"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_button" />

        <Button
            android:id="@+id/btn_clear_alerts"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="清空"
            android:textColor="@color/text_tertiary"
            android:textSize="11.5sp"
            android:background="@drawable/bg_pill_button"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- 3. 预警流水明细 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_alerts_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

</LinearLayout>
