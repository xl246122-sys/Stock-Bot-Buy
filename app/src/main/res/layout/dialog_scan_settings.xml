<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/md_theme_dark_surface"
    android:padding="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@color/border_subtle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="量化扫描与实盘网关设置"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="配置 A 股行情高频抓取频率与阿里云后台网关连接"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <!-- 刷新频率 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="扫描刷新频率"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_chip_normal"
        android:padding="3dp"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/btn_freq_1s"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="1 秒 (极速)"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_freq_2s"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="2 秒 (推荐实盘)"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_cyan" />

        <TextView
            android:id="@+id/btn_freq_5s"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="5 秒 (省电)"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 网关服务器配置 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="阿里云行情与交易网关"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/et_server_url"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="http://47.107.179.201:8000"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:background="@drawable/bg_card_dark"
        android:paddingHorizontal="12dp"
        android:layout_marginTop="8dp" />

    <!-- 测试连接与触觉反馈测试 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btn_test_connection"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="📡 测试云端网关"
            android:textColor="@color/stock_cyan"
            android:textSize="13sp"
            android:background="@drawable/bg_badge_cyan" />

        <Button
            android:id="@+id/btn_test_haptic"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="📳 测试阶梯触觉"
            android:textColor="@color/stock_gold"
            android:textSize="13sp"
            android:background="@drawable/bg_badge_gold"
            android:layout_marginStart="10dp" />
    </LinearLayout>

</LinearLayout>
